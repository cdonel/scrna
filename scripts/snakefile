import os

dir = config.get("samples_dir", "../data/test")
file = config.get("samples_file", "test.txt")

full_path = os.path.join(dir, file)

with open(full_path, "r", encoding="utf-8") as file:
    samples = file.read().splitlines()

rule all:
	input:
		"../results/multiqc_report.html",
		expand("../data/quality_control/library_saturation/{samples}.png", samples=samples),
		expand("../data/quality_control/rna_features/{samples}.png", samples=samples),
		"../results/umap_cluster.png",
		"../results/clusterfeatures.csv"


rule prefetch:
	resources:
		ncbi_connections=1
	params:
		dir = "../data/fastq",
		samples = "{samples}"
	output:
		"../data/fastq/{samples}/{samples}.sra"
	conda:
		"../envs/fetch.yaml"
	shell:
		"prefetch {params.samples} -O {params.dir}"


rule fasterq_dump:
	params:
		dir = "../data/fastq/{samples}"
	input:
		"../data/fastq/{samples}/{samples}.sra"
	output:
		"../data/fastq/{samples}/{samples}_1.fastq",
		"../data/fastq/{samples}/{samples}_2.fastq",
		"../data/fastq/{samples}/{samples}_3.fastq"
	conda:
		"../envs/fetch.yaml"
	shell:
		"fasterq-dump --split-files --include-technical {params.dir} -O {params.dir}"


rule fastqc:
	params:
		dir = "../data/quality_control/fastqc/{samples}"
	input:
		"../data/fastq/{samples}/{samples}_2.fastq",
		"../data/fastq/{samples}/{samples}_3.fastq"
	output:
		"../data/quality_control/fastqc/{samples}/{samples}_2_fastqc.html",
		"../data/quality_control/fastqc/{samples}/{samples}_2_fastqc.zip",
		"../data/quality_control/fastqc/{samples}/{samples}_3_fastqc.html",
		"../data/quality_control/fastqc/{samples}/{samples}_3_fastqc.zip"
	conda:
		"../envs/multiqc.yaml"
	shell:
		"fastqc {input} --outdir {params.dir}"

	
rule sample_multiqc:
	params:
		in_dir = "../data/quality_control/fastqc/{samples}",
		out_dir = "../data/quality_control/multiqc/{samples}",
		filename = "{samples}_multiqc"
	input:
		"../data/quality_control/fastqc/{samples}/{samples}_2_fastqc.html",
		"../data/quality_control/fastqc/{samples}/{samples}_2_fastqc.zip",
		"../data/quality_control/fastqc/{samples}/{samples}_3_fastqc.html",
		"../data/quality_control/fastqc/{samples}/{samples}_3_fastqc.zip"	
	output:
		"../data/quality_control/multiqc/{samples}/{samples}_multiqc.html"
	conda:
		"../envs/multiqc.yaml"
	shell:
		"multiqc {params.in_dir} --filename {params.filename} -o {params.out_dir}"


rule agg_multiqc:
	params:
		in_dir = "../data/quality_control/multiqc",
		out_dir = "../results"
	input:
		expand("../data/quality_control/multiqc/{samples}/{samples}_multiqc.html", samples=samples)
	output:
		"../results/multiqc_report.html"
	conda:
		"../envs/multiqc.yaml"
	shell:
		"multiqc {params.in_dir} -o {params.out_dir} --filename multiqc_report"


rule ref_index:
	output:
		"../data/ref_index/index.idx",
		"../data/ref_index/t2g.txt"
	conda:
		"../envs/kb.yaml"
	shell:
		"kb ref -d human -i ../data/ref_index/index.idx -g ../data/ref_index/t2g.txt"


rule kb_align:
	params:
		out_dir="../data/kb_counts/{samples}"
	input:
		index = "../data/ref_index/index.idx",
		t2g = "../data/ref_index/t2g.txt",
		read_2 = "../data/fastq/{samples}/{samples}_2.fastq",
		read_3 = "../data/fastq/{samples}/{samples}_3.fastq"
	output:
		"../data/kb_counts/{samples}/counts_filtered/adata.h5ad",
		"../data/kb_counts/{samples}/counts_filtered/cells_x_genes.genes.names.txt",
		"../data/kb_counts/{samples}/counts_filtered/cells_x_genes.mtx"
	conda:
		"../envs/kb.yaml"
	shell:
		"kb count -i {input.index} -g {input.t2g} -o {params.out_dir} -x 10xv3 --filter bustools --h5ad -t 2 {input.read_2} {input.read_3}"


rule kb_qc:
	input:
		"../data/kb_counts/{samples}/counts_filtered/cells_x_genes.mtx"
	output:
		"../data/quality_control/library_saturation/{samples}.png"
	conda:
		"../envs/seurat.yaml"
	shell:
		"Rscript kb_qc.R -i {input} -n {samples} -o {output}"
	

rule to_seurat:
	params:
		sample = "{samples}"
	input:
		adata = "../data/kb_counts/{samples}/counts_filtered/adata.h5ad",
		gene_ids = "../data/kb_counts/{samples}/counts_filtered/cells_x_genes.genes.names.txt"
	output:
		"../data/seurat_objs/{samples}/{samples}.norm.rds"
	conda:
		"../envs/seurat.yaml"
	shell:
		"Rscript to_seurat.R -i {input.adata} -g {input.gene_ids} -n {params.sample} -o {output}"


rule lib_saturation:
	params:
		sample = "{samples}"
	input:
		"../data/seurat_objs/{samples}/{samples}.norm.rds"
	output:
		"../data/quality_control/rna_features/{samples}.png"
	conda:
		"../envs/seurat.yaml"
	shell:
		"Rscript seurat_qc.R -i {input} -o {output}"

		
rule layer_seurat:
	input:
		dir = "../data/test/test.txt",
		objs = expand("../data/seurat_objs/{samples}/{samples}.norm.rds", samples=samples)
	output:
		"../data/seurat_objs/merged/merged.norm.rds"
	conda:
		"../envs/seurat.yaml"
	shell:
		"Rscript merge_seurat.R -i {input.dir} -o {output}"


rule cluster:
	input:
		"../data/seurat_objs/merged/merged.norm.rds"
	output:
		"../results/umap_cluster.png",
		"../results/clusterfeatures.csv"
	conda:
		"../envs/seurat.yaml"
	shell:
		"Rscript cluster.R -i {input}"

